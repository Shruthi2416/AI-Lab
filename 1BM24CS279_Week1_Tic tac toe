
def display_board(board):
    print()
    for i in range(0, 9, 3):
        print(" " + " | ".join(board[i:i+3]))
        if i < 6:
            print("---+---+---")
    print()


def check_winner(board, player):
    win = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],
        [0, 3, 6], [1, 4, 7], [2, 5, 8],
        [0, 4, 8], [2, 4, 6]
    ]

    for line in win:
        if (board[line[0]] == player and
            board[line[1]] == player and
            board[line[2]] == player):
            return True

    return False


def play_game():
    board = [" "] * 9
    player = "X"

    print("TIC-TAC-TOE")
    print("Positions are numbered 1 to 9.")

    while True:
        display_board(board)

        try:
            position = int(input("Player " + player + ", enter position: "))
        except ValueError:
            print("Enter a valid number!")
            continue

        if position < 1 or position > 9:
            print("Choose a position between 1 and 9.")
            continue

        if board[position - 1] != " ":
            print("Position already occupied. Try again.")
            continue

        board[position - 1] = player

        if check_winner(board, player):
            display_board(board)
            print("Player", player, "wins!")
            break

        if " " not in board:
            display_board(board)
            print("Match Draw!")
            break

        if player == "X":
            player = "O"
        else:
            player = "X"


play_game()