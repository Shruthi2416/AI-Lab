import heapq

GOAL = (1, 2, 3,
        8, 0, 4,
        7, 6, 5)


# Misplaced Tiles Heuristic
def misplaced_tiles(state):
    count = 0
    for i in range(9):
        if state[i] != 0 and state[i] != GOAL[i]:
            count += 1
    return count


# Manhattan Distance Heuristic
def manhattan_distance(state):
    distance = 0

    for i in range(9):
        if state[i] != 0:
            current_row = i // 3
            current_col = i % 3

            goal_index = GOAL.index(state[i])
            goal_row = goal_index // 3
            goal_col = goal_index % 3

            distance += abs(current_row - goal_row)
            distance += abs(current_col - goal_col)

    return distance


# Generate possible next states
def get_neighbors(state):
    neighbors = []
    zero = state.index(0)
    row, col = zero // 3, zero % 3

    moves = [
        (-1, 0),  # Up
        (1, 0),   # Down
        (0, -1),  # Left
        (0, 1)    # Right
    ]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_index = new_row * 3 + new_col

            new_state = list(state)
            new_state[zero], new_state[new_index] = (
                new_state[new_index], new_state[zero]
            )

            neighbors.append(tuple(new_state))

    return neighbors


# Check whether the puzzle is solvable
def is_solvable(state):
    tiles = [x for x in state if x != 0]
    goal_tiles = [x for x in GOAL if x != 0]

    inversions = 0

    for i in range(len(tiles)):
        for j in range(i + 1, len(tiles)):
            if goal_tiles.index(tiles[i]) > goal_tiles.index(tiles[j]):
                inversions += 1

    return inversions % 2 == 0


# Print the puzzle
def print_board(state):
    for i in range(0, 9, 3):
        print(state[i:i + 3])
    print()


# A* Search Algorithm
def a_star(start, heuristic):
    pq = []
    heapq.heappush(
        pq, (heuristic(start), 0, start, [start])
    )

    visited = set()
    g_score = {start: 0}
    expanded = 0

    while pq:
        f, g, state, path = heapq.heappop(pq)

        if state in visited:
            continue

        visited.add(state)
        expanded += 1

        if state == GOAL:
            print("\nSolution Found!")
            print("Number of moves:", len(path) - 1)
            print("Number of expanded states:", expanded)

            print("\nSolution Path:")
            for step, board in enumerate(path):
                print("Step", step)
                print_board(board)

            print("Final Misplaced Tiles:",
                  misplaced_tiles(GOAL))
            print("Final Manhattan Distance:",
                  manhattan_distance(GOAL))

            return path

        for neighbor in get_neighbors(state):
            new_g = g + 1

            if neighbor not in g_score or new_g < g_score[neighbor]:
                g_score[neighbor] = new_g
                new_h = heuristic(neighbor)
                new_f = new_g + new_h

                heapq.heappush(
                    pq,
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    print("No solution found.")
    return None


# Main Program
print("Enter the initial puzzle row by row.")
print("Enter 0 for the blank space.")

start = []

for i in range(3):
    row = list(map(int, input("Row " + str(i + 1) + ": ").split()))
    start.extend(row)

start = tuple(start)

if len(start) != 9 or sorted(start) != list(range(9)):
    print("Invalid input! Enter numbers 0 to 8 exactly once.")

elif not is_solvable(start):
    print("This puzzle is not solvable.")

else:
    print("\nInitial State:")
    print_board(start)

    print("Initial Misplaced Tiles:",
          misplaced_tiles(start))

    print("Initial Manhattan Distance:",
          manhattan_distance(start))

    print("\nChoose Heuristic:")
    print("1. Misplaced Tiles")
    print("2. Manhattan Distance")

    choice = input("Enter choice (1 or 2): ")

    if choice == "1":
        print("\nUsing Misplaced Tiles Heuristic")
        solution = a_star(start, misplaced_tiles)

    elif choice == "2":
        print("\nUsing Manhattan Distance Heuristic")
        solution = a_star(start, manhattan_distance)

    else:
        print("Invalid choice!")
        solution = None

    # Calculate total Manhattan distance for the solution path
    if solution:
        total_distance = 0

        print("\nManhattan Distance at Each Step:")
        for step, state in enumerate(solution):
            distance = manhattan_distance(state)
            total_distance += distance

            print("Step", step)
            print_board(state)
            print("Manhattan Distance =", distance)
            print()

        print("--------------------------------")
        print("TOTAL MANHATTAN DISTANCE =", total_distance)
        print("--------------------------------")