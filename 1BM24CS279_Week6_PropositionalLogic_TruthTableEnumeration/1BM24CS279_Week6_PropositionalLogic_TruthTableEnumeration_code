from itertools import product

# Implication function
def implies(a, b):
    return (not a) or b

# Knowledge Base
def knowledge_base(P, Q, R):
    s1 = implies(Q, P)
    s2 = implies(P, not Q)
    s3 = Q or R

    return s1 and s2 and s3, s1, s2, s3

# Main program
print("PROPOSITIONAL LOGIC")
print("\nKnowledge Base:")
print("1. Q -> P")
print("2. P -> ~Q")
print("3. Q OR R")

print("\nTruth Table:")
print("P Q R | Q->P P->~Q Q|R | KB | R | R->P | Q->R")
print("-" * 55)

entail_R = True
entail_RP = True
entail_QR = True

for P, Q, R in product([False, True], repeat=3):

    KB, s1, s2, s3 = knowledge_base(P, Q, R)

    q1 = R
    q2 = implies(R, P)
    q3 = implies(Q, R)

    print(
        int(P), int(Q), int(R), "|",
        int(s1), int(s2), int(s3), "|",
        int(KB), "|",
        int(q1), "|", int(q2), "|", int(q3)
    )

    if KB and not q1:
        entail_R = False

    if KB and not q2:
        entail_RP = False

    if KB and not q3:
        entail_QR = False

print("\nENTAILMENT RESULTS:")
print("KB entails R:", entail_R)
print("KB entails R -> P:", entail_RP)
print("KB entails Q -> R:", entail_QR)
